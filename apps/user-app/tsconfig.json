{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next",
      
      }, 
    ],
    "allowImportingTsExtensions": true,
  },
  "include": [
    "types",
    "src",
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "postconfig.config.js",
    "taiwind.config.js"
  ]
}
